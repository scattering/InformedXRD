data_from_pyxtal

_symmetry_space_group_name_H-M 'P4/nbm'
_symmetry_Int_Tables_number                  125
_symmetry_cell_setting                tetragonal
_cell_length_a           15.071466
_cell_length_b           15.071466
_cell_length_c           11.485147
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           2608.840630

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-y+1/2, x, z'
4 'y, -x+1/2, z'
5 '-x+1/2, y, -z'
6 'x, -y+1/2, -z'
7 'y, x, -z'
8 '-y+1/2, -x+1/2, -z'
9 '-x, -y, -z'
10 'x+1/2, y+1/2, -z'
11 'y+1/2, -x, -z'
12 '-y, x+1/2, -z'
13 'x+1/2, -y, z'
14 '-x, y+1/2, z'
15 '-y, -x, z'
16 'y+1/2, x+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Eu     Eu       4     0.750000    0.250000    0.335160 1
Fr     Fr       8     0.443131   -0.443131    0.752334 1
Fr     Fr       4     0.000000    0.000000    0.000000 1
Fr     Fr       2     0.250000    0.250000    0.000000 1
Fr     Fr       2     0.750000    0.250000    0.000000 1
Ce     Ce       2     0.250000    0.250000    0.500000 1
#END

