data_from_pyxtal

_symmetry_space_group_name_H-M 'Pn-3'
_symmetry_Int_Tables_number                  201
_symmetry_cell_setting                     cubic
_cell_length_a           10.208177
_cell_length_b           10.208177
_cell_length_c           10.208177
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           1063.762261

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-x+1/2, y, -z+1/2'
4 'x, -y+1/2, -z+1/2'
5 'z, x, y'
6 'z, -x+1/2, -y+1/2'
7 '-z+1/2, -x+1/2, y'
8 '-z+1/2, x, -y+1/2'
9 'y, z, x'
10 '-y+1/2, z, -x+1/2'
11 'y, -z+1/2, -x+1/2'
12 '-y+1/2, -z+1/2, x'
13 '-x, -y, -z'
14 'x+1/2, y+1/2, -z'
15 'x+1/2, -y, z+1/2'
16 '-x, y+1/2, z+1/2'
17 '-z, -x, -y'
18 '-z, x+1/2, y+1/2'
19 'z+1/2, x+1/2, -y'
20 'z+1/2, -x, y+1/2'
21 '-y, -z, -x'
22 'y+1/2, -z, x+1/2'
23 '-y, z+1/2, x+1/2'
24 'y+1/2, z+1/2, -x'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ge     Ge      12     0.097331    0.750000    0.250000 1
Ge     Ge      12     0.626243    0.250000    0.250000 1
Ta     Ta       8     0.128638    0.128638    0.128638 1
Cl     Cl       4     0.500000    0.500000    0.500000 1
Cl     Cl       4     0.000000    0.000000    0.000000 1
