data_from_pyxtal

_symmetry_space_group_name_H-M 'P422'
_symmetry_Int_Tables_number                   89
_symmetry_cell_setting                tetragonal
_cell_length_a            9.672435
_cell_length_b            9.672435
_cell_length_c           17.433645
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           1631.022233

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z'
4 'y, -x, z'
5 '-x, y, -z'
6 'x, -y, -z'
7 'y, x, -z'
8 '-y, -x, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Bi     Bi       4     0.381364    0.500000    0.000000 1
Bi     Bi       1     0.000000    0.000000    0.000000 1
Bi     Bi       2     0.500000    0.500000    0.813994 1
Ac     Ac       4     0.838166    0.838166    0.000000 1
