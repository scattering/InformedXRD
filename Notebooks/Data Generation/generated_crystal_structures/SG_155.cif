data_from_pyxtal

_symmetry_space_group_name_H-M 'R32'
_symmetry_Int_Tables_number                  155
_symmetry_cell_setting                  trigonal
_cell_length_a           15.248433
_cell_length_b           15.248433
_cell_length_c            7.625906
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume           1535.580328

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 'y, x, -z'
5 'x-y, -y, -z'
6 '-x, -x+y, -z'
7 'x+2/3, y+1/3, z+1/3'
8 '-y+2/3, x-y+1/3, z+1/3'
9 '-x+y+2/3, -x+1/3, z+1/3'
10 'y+2/3, x+1/3, -z+1/3'
11 'x-y+2/3, -y+1/3, -z+1/3'
12 '-x+2/3, -x+y+1/3, -z+1/3'
13 'x+1/3, y+2/3, z+2/3'
14 '-y+1/3, x-y+2/3, z+2/3'
15 '-x+y+1/3, -x+2/3, z+2/3'
16 'y+1/3, x+2/3, -z+2/3'
17 'x-y+1/3, -y+2/3, -z+2/3'
18 '-x+1/3, -x+y+2/3, -z+2/3'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Sc     Sc      18     0.786136    0.355131    0.456425 1
Xe     Xe      18     0.343835    0.914724    0.490357 1
Pm     Pm       9     0.518992    0.000000    0.000000 1
