data_from_pyxtal

_symmetry_space_group_name_H-M 'P42bc'
_symmetry_Int_Tables_number                  106
_symmetry_cell_setting                tetragonal
_cell_length_a            9.389598
_cell_length_b            9.389598
_cell_length_c            8.894361
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            784.167372

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z+1/2'
4 'y, -x, z+1/2'
5 'x+1/2, -y+1/2, z'
6 '-x+1/2, y+1/2, z'
7 '-y+1/2, -x+1/2, z+1/2'
8 'y+1/2, x+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Mn     Mn       8     0.522053    0.709786    0.660445 1
Hf     Hf       8     0.691850    0.281079    0.686116 1
Tl     Tl       8     0.576139    0.658331    0.003570 1
#END

