data_from_pyxtal

_symmetry_space_group_name_H-M 'Iba2'
_symmetry_Int_Tables_number                   45
_symmetry_cell_setting              orthorhombic
_cell_length_a            9.560519
_cell_length_b            5.747672
_cell_length_c            8.554715
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            470.087803

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/2, -y+1/2, z'
4 '-x+1/2, y+1/2, z'
5 'x+1/2, y+1/2, z+1/2'
6 '-x+1/2, -y+1/2, z+1/2'
7 'x+1, -y+1, z+1/2'
8 '-x+1, y+1, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Te     Te       4     0.000000    0.500000    0.957003 1
Gd     Gd       8     0.828276    0.914590    0.677099 1
Cl     Cl       4     0.000000    0.500000    0.237617 1
#END

