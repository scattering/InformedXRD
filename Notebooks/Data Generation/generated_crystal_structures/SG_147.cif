data_from_pyxtal

_symmetry_space_group_name_H-M 'P-3'
_symmetry_Int_Tables_number                  147
_symmetry_cell_setting                  trigonal
_cell_length_a            7.201387
_cell_length_b            7.201387
_cell_length_c            7.036605
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            316.028409

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 '-x, -y, -z'
5 'y, -x+y, -z'
6 'x-y, x, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ho     Ho       6     0.003969    0.300724    0.339654 1
Nd     Nd       1     0.000000    0.000000    0.500000 1
Nd     Nd       2     0.333333    0.666667    0.711777 1
#END

