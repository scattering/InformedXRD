data_from_pyxtal

_symmetry_space_group_name_H-M 'Pmc21'
_symmetry_Int_Tables_number                   26
_symmetry_cell_setting              orthorhombic
_cell_length_a            8.840627
_cell_length_b            9.153849
_cell_length_c            7.811628
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            632.161967

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z+1/2'
3 'x, -y, z+1/2'
4 '-x, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Sr     Sr       2     0.500000    0.949862    0.333273 1
Sr     Sr       2     0.500000    0.607792    0.029569 1
B      B        2     0.000000    0.373005    0.869273 1
B      B        2     0.500000    0.673851    0.229980 1
Fr     Fr       2     0.000000    0.375123    0.486098 1
