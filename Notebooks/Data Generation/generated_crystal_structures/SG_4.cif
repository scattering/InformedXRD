data_from_pyxtal

_symmetry_space_group_name_H-M 'P21'
_symmetry_Int_Tables_number                    4
_symmetry_cell_setting                monoclinic
_cell_length_a            6.174732
_cell_length_b            6.968951
_cell_length_c            6.228980
_cell_angle_alpha        90.000000
_cell_angle_beta         89.537915
_cell_angle_gamma        90.000000
_cell_volume            268.033014

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Pm     Pm       2     0.357880    0.966100    0.399549 1
Sr     Sr       2     0.025676    0.434748    0.101453 1
Tl     Tl       2     0.062808    0.186335    0.331341 1
#END

