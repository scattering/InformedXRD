data_from_pyxtal

_symmetry_space_group_name_H-M 'P3221'
_symmetry_Int_Tables_number                  154
_symmetry_cell_setting                  trigonal
_cell_length_a           10.073451
_cell_length_b           10.073451
_cell_length_c            3.557044
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            312.590955

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z+2/3'
3 '-x+y, -x, z+1/3'
4 'y, x, -z'
5 'x-y, -y, -z+1/3'
6 '-x, -x+y, -z+2/3'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       3     0.767909    0.000000    0.166667 1
Eu     Eu       6     0.854788    0.451978    0.968389 1
As     As       3     0.179459    0.000000    0.166667 1
#END

