data_from_pyxtal

_symmetry_space_group_name_H-M 'Pcc2'
_symmetry_Int_Tables_number                   27
_symmetry_cell_setting              orthorhombic
_cell_length_a            5.760548
_cell_length_b            7.271680
_cell_length_c            4.484221
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            187.838928

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x, -y, z+1/2'
4 '-x, y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Re     Re       2     0.500000    0.000000    0.711185 1
Ar     Ar       4     0.749158    0.178284    0.650951 1
Nb     Nb       4     0.022965    0.120426    0.036728 1
#END

