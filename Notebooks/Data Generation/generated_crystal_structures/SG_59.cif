data_from_pyxtal

_symmetry_space_group_name_H-M 'Pmmn'
_symmetry_Int_Tables_number                   59
_symmetry_cell_setting              orthorhombic
_cell_length_a           11.297066
_cell_length_b            5.208317
_cell_length_c            8.615631
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            506.932504

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-x, y+1/2, -z'
4 'x+1/2, -y, -z'
5 '-x, -y, -z'
6 'x+1/2, y+1/2, -z'
7 'x, -y+1/2, z'
8 '-x+1/2, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
I      I        8     0.354294    0.481854    0.129384 1
Rb     Rb       4     0.000000    0.000000    0.500000 1
#END

