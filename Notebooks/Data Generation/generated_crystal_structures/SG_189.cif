data_from_pyxtal

_symmetry_space_group_name_H-M 'P-62m'
_symmetry_Int_Tables_number                  189
_symmetry_cell_setting                 hexagonal
_cell_length_a            7.002967
_cell_length_b            7.002967
_cell_length_c            7.295924
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            309.866817

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 'x, y, -z'
5 '-y, x-y, -z'
6 '-x+y, -x, -z'
7 'y, x, -z'
8 'x-y, -y, -z'
9 '-x, -x+y, -z'
10 'y, x, z'
11 'x-y, -y, z'
12 '-x, -x+y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Bi     Bi       1     0.000000    0.000000    0.500000 1
Bi     Bi       3     0.772685    0.000000    0.500000 1
U      U        2     0.333333    0.666667    0.000000 1
U      U        2     0.333333    0.666667    0.500000 1
P      P        4     0.333333    0.666667    0.723213 1
#END

