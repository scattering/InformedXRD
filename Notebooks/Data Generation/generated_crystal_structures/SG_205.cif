data_from_pyxtal

_symmetry_space_group_name_H-M 'Pa-3'
_symmetry_Int_Tables_number                  205
_symmetry_cell_setting                     cubic
_cell_length_a            7.774002
_cell_length_b            7.774002
_cell_length_c            7.774002
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            469.822660

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z+1/2'
3 '-x, y+1/2, -z+1/2'
4 'x+1/2, -y+1/2, -z'
5 'z, x, y'
6 'z+1/2, -x+1/2, -y'
7 '-z+1/2, -x, y+1/2'
8 '-z, x+1/2, -y+1/2'
9 'y, z, x'
10 '-y, z+1/2, -x+1/2'
11 'y+1/2, -z+1/2, -x'
12 '-y+1/2, -z, x+1/2'
13 '-x, -y, -z'
14 'x+1/2, y, -z+1/2'
15 'x, -y+1/2, z+1/2'
16 '-x+1/2, y+1/2, z'
17 '-z, -x, -y'
18 '-z+1/2, x+1/2, y'
19 'z+1/2, x, -y+1/2'
20 'z, -x+1/2, y+1/2'
21 '-y, -z, -x'
22 'y, -z+1/2, x+1/2'
23 '-y+1/2, z+1/2, x'
24 'y+1/2, z, -x+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Pm     Pm       4     0.000000    0.000000    0.000000 1
Pm     Pm       4     0.500000    0.500000    0.500000 1
Pt     Pt       8     0.300353    0.300353    0.300353 1
#END

