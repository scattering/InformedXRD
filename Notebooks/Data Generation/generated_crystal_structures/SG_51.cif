data_from_pyxtal

_symmetry_space_group_name_H-M 'Pmma'
_symmetry_Int_Tables_number                   51
_symmetry_cell_setting              orthorhombic
_cell_length_a            6.809289
_cell_length_b            6.273183
_cell_length_c            5.654872
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            241.553012

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z'
3 '-x, y, -z'
4 'x+1/2, -y, -z'
5 '-x, -y, -z'
6 'x+1/2, y, -z'
7 'x, -y, z'
8 '-x+1/2, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ga     Ga       2     0.250000    0.000000    0.788893 1
Ba     Ba       2     0.250000    0.500000    0.874497 1
Ba     Ba       2     0.000000    0.000000    0.500000 1
#END

