data_from_pyxtal

_symmetry_space_group_name_H-M 'P3m1'
_symmetry_Int_Tables_number                  156
_symmetry_cell_setting                  trigonal
_cell_length_a            2.982718
_cell_length_b            2.982718
_cell_length_c           29.036849
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            223.719827

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 '-y, -x, z'
5 '-x+y, y, z'
6 'x, x-y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Pb     Pb       1     0.666667    0.333333    0.439974 1
Pb     Pb       1     0.666667    0.333333    0.855519 1
Pb     Pb       1     0.000000    0.000000    0.191853 1
Pr     Pr       1     0.666667    0.333333    0.224168 1
Pr     Pr       1     0.333333    0.666667    0.409621 1
Pr     Pr       1     0.000000    0.000000    0.942210 1
