data_from_pyxtal

_symmetry_space_group_name_H-M 'P4322'
_symmetry_Int_Tables_number                   95
_symmetry_cell_setting                tetragonal
_cell_length_a            7.987976
_cell_length_b            7.987976
_cell_length_c            7.373822
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            470.507068

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z+1/2'
3 '-y, x, z+3/4'
4 'y, -x, z+1/4'
5 '-x, y, -z'
6 'x, -y, -z+1/2'
7 'y, x, -z+1/4'
8 '-y, -x, -z+3/4'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
W      W        4     0.000000    0.966421    0.000000 1
W      W        4     0.500000    0.786420    0.000000 1
W      W        4     0.822809    0.822809    0.625000 1
O      O        4     0.500000    0.241699    0.000000 1
Bi     Bi       4     0.000000    0.678760    0.000000 1
