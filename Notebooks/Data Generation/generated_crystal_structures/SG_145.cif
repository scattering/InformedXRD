data_from_pyxtal

_symmetry_space_group_name_H-M 'P32'
_symmetry_Int_Tables_number                  145
_symmetry_cell_setting                  trigonal
_cell_length_a            5.368722
_cell_length_b            5.368722
_cell_length_c            4.769864
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            119.063481

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z+2/3'
3 '-x+y, -x, z+1/3'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
H      H        3     0.664774    0.300199    0.266168 1
Ge     Ge       3     0.976615    0.847259    0.029760 1
Mn     Mn       3     0.626512    0.777283    0.034673 1
#END

