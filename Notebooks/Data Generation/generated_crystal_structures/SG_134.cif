data_from_pyxtal

_symmetry_space_group_name_H-M 'P42/nnm'
_symmetry_Int_Tables_number                  134
_symmetry_cell_setting                tetragonal
_cell_length_a            7.089483
_cell_length_b            7.089483
_cell_length_c           16.885055
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            848.655879

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-y+1/2, x, z+1/2'
4 'y, -x+1/2, z+1/2'
5 '-x+1/2, y, -z+1/2'
6 'x, -y+1/2, -z+1/2'
7 'y, x, -z'
8 '-y+1/2, -x+1/2, -z'
9 '-x, -y, -z'
10 'x+1/2, y+1/2, -z'
11 'y+1/2, -x, -z+1/2'
12 '-y, x+1/2, -z+1/2'
13 'x+1/2, -y, z+1/2'
14 '-x, y+1/2, z+1/2'
15 '-y, -x, z'
16 'y+1/2, x+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Pt     Pt       8     0.567596   -0.567596    0.215556 1
Pt     Pt       4     0.000000    0.000000    0.000000 1
Pt     Pt       4     0.250000    0.250000    0.250000 1
Mn     Mn       8     0.841951    0.158049    0.363937 1
Mn     Mn       4     0.250000    0.250000    0.000000 1
Mn     Mn       4     0.750000    0.250000    0.036845 1
Yb     Yb       2     0.250000    0.750000    0.250000 1
Yb     Yb       2     0.750000    0.250000    0.250000 1
