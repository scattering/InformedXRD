data_from_pyxtal

_symmetry_space_group_name_H-M 'P-43n'
_symmetry_Int_Tables_number                  218
_symmetry_cell_setting                     cubic
_cell_length_a           11.925430
_cell_length_b           11.925430
_cell_length_c           11.925430
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           1695.985617

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-x, y, -z'
4 'x, -y, -z'
5 'z, x, y'
6 'z, -x, -y'
7 '-z, -x, y'
8 '-z, x, -y'
9 'y, z, x'
10 '-y, z, -x'
11 'y, -z, -x'
12 '-y, -z, x'
13 'y+1/2, x+1/2, z+1/2'
14 '-y+1/2, -x+1/2, z+1/2'
15 'y+1/2, -x+1/2, -z+1/2'
16 '-y+1/2, x+1/2, -z+1/2'
17 'x+1/2, z+1/2, y+1/2'
18 '-x+1/2, z+1/2, -y+1/2'
19 '-x+1/2, -z+1/2, y+1/2'
20 'x+1/2, -z+1/2, -y+1/2'
21 'z+1/2, y+1/2, x+1/2'
22 'z+1/2, -y+1/2, -x+1/2'
23 '-z+1/2, y+1/2, -x+1/2'
24 '-z+1/2, -y+1/2, x+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Hf     Hf      24     0.153780    0.081811    0.756345 1
Hf     Hf      12     0.382114    0.000000    0.500000 1
Mn     Mn       6     0.250000    0.500000    0.000000 1
Mn     Mn      12     0.608519    0.500000    0.000000 1
