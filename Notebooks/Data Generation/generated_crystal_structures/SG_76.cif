data_from_pyxtal

_symmetry_space_group_name_H-M 'P41'
_symmetry_Int_Tables_number                   76
_symmetry_cell_setting                tetragonal
_cell_length_a            7.090491
_cell_length_b            7.090491
_cell_length_c            5.298967
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            266.405915

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z+1/2'
3 '-y, x, z+1/4'
4 'y, -x, z+3/4'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Mo     Mo       4     0.371469    0.365135    0.413277 1
V      V        4     0.578238    0.100262    0.035013 1
#END

