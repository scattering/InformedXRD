data_from_pyxtal

_symmetry_space_group_name_H-M 'I41'
_symmetry_Int_Tables_number                   80
_symmetry_cell_setting                tetragonal
_cell_length_a            6.882238
_cell_length_b            6.882238
_cell_length_c           12.650966
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            599.215505

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z+1/2'
3 '-y, x+1/2, z+1/4'
4 'y+1/2, -x, z+3/4'
5 'x+1/2, y+1/2, z+1/2'
6 '-x+1, -y+1, z+1'
7 '-y+1/2, x+1, z+3/4'
8 'y+1, -x+1/2, z+5/4'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Sr     Sr       4     0.000000    0.000000    0.031491 1
Sr     Sr       4     0.000000    0.000000    0.713791 1
Zn     Zn       8     0.204383    0.166413    0.195335 1
B      B        8     0.943924    0.118489    0.891021 1
#END

