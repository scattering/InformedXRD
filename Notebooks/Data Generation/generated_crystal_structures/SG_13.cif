data_from_pyxtal

_symmetry_space_group_name_H-M 'P2/c'
_symmetry_Int_Tables_number                   13
_symmetry_cell_setting                monoclinic
_cell_length_a            4.889562
_cell_length_b            6.217409
_cell_length_c            6.872710
_cell_angle_alpha        90.000000
_cell_angle_beta         92.123151
_cell_angle_gamma        90.000000
_cell_volume            208.789749

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z+1/2'
3 '-x, -y, -z'
4 'x, -y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Na     Na       2     0.000000    0.353651    0.250000 1
Ba     Ba       2     0.000000    0.925252    0.250000 1
#END

