data_from_pyxtal

_symmetry_space_group_name_H-M 'I-4m2'
_symmetry_Int_Tables_number                  119
_symmetry_cell_setting                tetragonal
_cell_length_a            7.812295
_cell_length_b            7.812295
_cell_length_c            4.862360
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            296.759289

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'y, -x, -z'
4 '-y, x, -z'
5 'x, -y, z'
6 '-x, y, z'
7 'y, x, -z'
8 '-y, -x, -z'
9 'x+1/2, y+1/2, z+1/2'
10 '-x+1/2, -y+1/2, z+1/2'
11 'y+1/2, -x+1/2, -z+1/2'
12 '-y+1/2, x+1/2, -z+1/2'
13 'x+1/2, -y+1/2, z+1/2'
14 '-x+1/2, y+1/2, z+1/2'
15 'y+1/2, x+1/2, -z+1/2'
16 '-y+1/2, -x+1/2, -z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ac     Ac       2     0.000000    0.500000    0.750000 1
Ge     Ge       2     0.000000    0.500000    0.250000 1
Ge     Ge       2     0.000000    0.000000    0.000000 1
Re     Re       2     0.000000    0.000000    0.500000 1
#END

