data_from_pyxtal

_symmetry_space_group_name_H-M 'P61'
_symmetry_Int_Tables_number                  169
_symmetry_cell_setting                 hexagonal
_cell_length_a           15.161992
_cell_length_b           15.161992
_cell_length_c            4.970840
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            989.630221

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z+1/3'
3 '-x+y, -x, z+2/3'
4 '-x, -y, z+1/2'
5 'y, -x+y, z+5/6'
6 'x-y, x, z+1/6'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
C      C        6     0.173500    0.721127    0.230991 1
Fr     Fr       6     0.945688    0.491774    0.887563 1
#END

