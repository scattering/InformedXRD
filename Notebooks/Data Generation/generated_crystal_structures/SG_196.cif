35 'y+1/2, -z, -x+1/2'
36 '-y+1/2, -z, x+1/2'
37 'x+1/2, y+1/2, z'
38 '-x+1/2, -y+1/2, z'
39 '-x+1/2, y+1/2, -z'
40 'x+1/2, -y+1/2, -z'
41 'z+1/2, x+1/2, y'
42 'z+1/2, -x+1/2, -y'
43 '-z+1/2, -x+1/2, y'
44 '-z+1/2, x+1/2, -y'
45 'y+1/2, z+1/2, x'
46 '-y+1/2, z+1/2, -x'
47 'y+1/2, -z+1/2, -x'
48 '-y+1/2, -z+1/2, x'

