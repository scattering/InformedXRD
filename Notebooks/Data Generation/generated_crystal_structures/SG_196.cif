27 '-x+1/2, y, -z+1/2'
28 'x+1/2, -y, -z+1/2'
29 'z+1/2, x, y+1/2'
30 'z+1/2, -x, -y+1/2'
31 '-z+1/2, -x, y+1/2'
32 '-z+1/2, x, -y+1/2'
