data_from_pyxtal

_symmetry_space_group_name_H-M 'P42mc'
_symmetry_Int_Tables_number                  105
_symmetry_cell_setting                tetragonal
_cell_length_a            4.553244
_cell_length_b            4.553244
_cell_length_c            9.652394
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            200.113708

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z+1/2'
4 'y, -x, z+1/2'
5 'x, -y, z'
6 '-x, y, z'
7 '-y, -x, z+1/2'
8 'y, x, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ac     Ac       2     0.500000    0.500000    0.883626 1
S      S        2     0.000000    0.500000    0.344388 1
S      S        2     0.000000    0.500000    0.587424 1
#END

