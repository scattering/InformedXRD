data_from_pyxtal

_symmetry_space_group_name_H-M 'Ama2'
_symmetry_Int_Tables_number                   40
_symmetry_cell_setting              orthorhombic
_cell_length_a            5.849498
_cell_length_b            9.446390
_cell_length_c            6.204540
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            342.842033

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/2, -y, z'
4 '-x+1/2, y, z'
5 'x, y+1/2, z+1/2'
6 '-x, -y+1/2, z+1/2'
7 'x+1/2, -y+1/2, z+1/2'
8 '-x+1/2, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Dy     Dy       4     0.250000    0.771846    0.748759 1
Dy     Dy       4     0.000000    0.000000    0.747396 1
Cu     Cu       4     0.000000    0.000000    0.091222 1
#END

