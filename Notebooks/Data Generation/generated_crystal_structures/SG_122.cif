data_from_pyxtal

_symmetry_space_group_name_H-M 'I-42d'
_symmetry_Int_Tables_number                  122
_symmetry_cell_setting                tetragonal
_cell_length_a           10.576623
_cell_length_b           10.576623
_cell_length_c            6.863441
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            767.778596

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'y, -x, -z'
4 '-y, x, -z'
5 '-x+1/2, y, -z+3/4'
6 'x+1/2, -y, -z+3/4'
7 '-y+1/2, -x, z+3/4'
8 'y+1/2, x, z+3/4'
9 'x+1/2, y+1/2, z+1/2'
10 '-x+1/2, -y+1/2, z+1/2'
11 'y+1/2, -x+1/2, -z+1/2'
12 '-y+1/2, x+1/2, -z+1/2'
13 '-x+1, y+1/2, -z+5/4'
14 'x+1, -y+1/2, -z+5/4'
15 '-y+1, -x+1/2, z+5/4'
16 'y+1, x+1/2, z+5/4'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Tc     Tc       4     0.000000    0.000000    0.500000 1
Gd     Gd       8     0.291304    0.250000    0.125000 1
Rn     Rn       8     0.000000    0.000000    0.887691 1
#END

