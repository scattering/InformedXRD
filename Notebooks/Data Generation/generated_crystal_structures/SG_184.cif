data_from_pyxtal

_symmetry_space_group_name_H-M 'P6cc'
_symmetry_Int_Tables_number                  184
_symmetry_cell_setting                 hexagonal
_cell_length_a            8.540202
_cell_length_b            8.540202
_cell_length_c           10.543934
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            665.992889

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 '-x, -y, z'
5 'y, -x+y, z'
6 'x-y, x, z'
7 '-y, -x, z+1/2'
8 '-x+y, y, z+1/2'
9 'x, x-y, z+1/2'
10 'y, x, z+1/2'
11 'x-y, -y, z+1/2'
12 '-x, -x+y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Pt     Pt       6     0.500000    0.000000    0.367772 1
Pt     Pt       6     0.500000    0.000000    0.615579 1
Eu     Eu      12     0.804020    0.637188    0.605473 1
#END

