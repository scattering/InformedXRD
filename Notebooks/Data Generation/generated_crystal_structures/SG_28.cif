data_from_pyxtal

_symmetry_space_group_name_H-M 'Pma2'
_symmetry_Int_Tables_number                   28
_symmetry_cell_setting              orthorhombic
_cell_length_a            7.362504
_cell_length_b            7.148376
_cell_length_c            6.260291
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            329.478760

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/2, -y, z'
4 '-x+1/2, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Pm     Pm       2     0.000000    0.500000    0.775936 1
Pm     Pm       2     0.250000    0.188073    0.452396 1
Pm     Pm       2     0.000000    0.000000    0.802032 1
Pr     Pr       2     0.000000    0.500000    0.188557 1
