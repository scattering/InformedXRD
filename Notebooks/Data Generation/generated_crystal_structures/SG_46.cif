data_from_pyxtal

_symmetry_space_group_name_H-M 'Ima2'
_symmetry_Int_Tables_number                   46
_symmetry_cell_setting              orthorhombic
_cell_length_a            7.407421
_cell_length_b           13.992237
_cell_length_c            6.192399
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            641.819869

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/2, -y, z'
4 '-x+1/2, y, z'
5 'x+1/2, y+1/2, z+1/2'
6 '-x+1/2, -y+1/2, z+1/2'
7 'x+1, -y+1/2, z+1/2'
8 '-x+1, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
K      K        4     0.250000    0.060346    0.404464 1
Eu     Eu       4     0.000000    0.000000    0.742957 1
Eu     Eu       4     0.250000    0.265178    0.226470 1
