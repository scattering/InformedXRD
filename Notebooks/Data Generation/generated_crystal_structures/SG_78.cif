data_from_pyxtal

_symmetry_space_group_name_H-M 'P43'
_symmetry_Int_Tables_number                   78
_symmetry_cell_setting                tetragonal
_cell_length_a            9.097190
_cell_length_b            9.097190
_cell_length_c            2.713416
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            224.559195

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z+1/2'
3 '-y, x, z+3/4'
4 'y, -x, z+1/4'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        4     0.553820    0.892489    0.097500 1
Sm     Sm       4     0.977071    0.804733    0.731619 1
N      N        4     0.557331    0.024103    0.392201 1
#END

