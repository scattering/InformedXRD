data_from_pyxtal

_symmetry_space_group_name_H-M 'P6/mcc'
_symmetry_Int_Tables_number                  192
_symmetry_cell_setting                 hexagonal
_cell_length_a           13.516854
_cell_length_b           13.516854
_cell_length_c            7.227473
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume           1143.584748

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 '-x, -y, z'
5 'y, -x+y, z'
6 'x-y, x, z'
7 'y, x, -z+1/2'
8 'x-y, -y, -z+1/2'
9 '-x, -x+y, -z+1/2'
10 '-y, -x, -z+1/2'
11 '-x+y, y, -z+1/2'
12 'x, x-y, -z+1/2'
13 '-x, -y, -z'
14 'y, -x+y, -z'
15 'x-y, x, -z'
16 'x, y, -z'
17 '-y, x-y, -z'
18 '-x+y, -x, -z'
19 '-y, -x, z+1/2'
20 '-x+y, y, z+1/2'
21 'x, x-y, z+1/2'
22 'y, x, z+1/2'
23 'x-y, -y, z+1/2'
24 '-x, -x+y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ge     Ge      24     0.345402    0.479565    0.236232 1
Yb     Yb       4     0.333333    0.666667    0.250000 1
#END

