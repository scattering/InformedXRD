data_from_pyxtal

_symmetry_space_group_name_H-M 'Pnna'
_symmetry_Int_Tables_number                   52
_symmetry_cell_setting              orthorhombic
_cell_length_a            9.065777
_cell_length_b            8.913477
_cell_length_c           11.250289
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            909.108834

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z'
3 '-x+1/2, y+1/2, -z+1/2'
4 'x, -y+1/2, -z+1/2'
5 '-x, -y, -z'
6 'x+1/2, y, -z'
7 'x+1/2, -y+1/2, z+1/2'
8 '-x, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ac     Ac       4     0.250000    0.000000    0.763642 1
Rn     Rn       4     0.208941    0.250000    0.250000 1
Rn     Rn       4     0.947803    0.250000    0.250000 1
Rn     Rn       4     0.000000    0.000000    0.000000 1
Rn     Rn       4     0.250000    0.000000    0.516997 1
Ge     Ge       4     0.000000    0.000000    0.500000 1
