data_from_pyxtal

_symmetry_space_group_name_H-M 'Imm2'
_symmetry_Int_Tables_number                   44
_symmetry_cell_setting              orthorhombic
_cell_length_a            5.670386
_cell_length_b            9.388263
_cell_length_c            9.243847
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            492.096872

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x, -y, z'
4 '-x, y, z'
5 'x+1/2, y+1/2, z+1/2'
6 '-x+1/2, -y+1/2, z+1/2'
7 'x+1/2, -y+1/2, z+1/2'
8 '-x+1/2, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Na     Na       2     0.000000    0.000000    0.024590 1
Ra     Ra       2     0.000000    0.500000    0.991312 1
Ra     Ra       2     0.000000    0.000000    0.616877 1
Bi     Bi       2     0.000000    0.500000    0.341708 1
