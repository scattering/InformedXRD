data_from_pyxtal

_symmetry_space_group_name_H-M 'P312'
_symmetry_Int_Tables_number                  149
_symmetry_cell_setting                  trigonal
_cell_length_a            8.597204
_cell_length_b            8.597204
_cell_length_c            5.854565
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            374.748359

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 '-y, -x, -z'
5 '-x+y, y, -z'
6 'x, x-y, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
I      I        6     0.079581    0.138646    0.243424 1
Er     Er       3     0.121042    0.878958    0.500000 1
Er     Er       1     0.333333    0.666667    0.500000 1
Er     Er       1     0.000000    0.000000    0.000000 1
Er     Er       1     0.333333    0.666667    0.000000 1
