data_from_pyxtal

_symmetry_space_group_name_H-M 'P4/ncc'
_symmetry_Int_Tables_number                  130
_symmetry_cell_setting                tetragonal
_cell_length_a           25.804591
_cell_length_b           25.804591
_cell_length_c            4.615853
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           3073.589760

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-y+1/2, x, z'
4 'y, -x+1/2, z'
5 '-x, y+1/2, -z+1/2'
6 'x+1/2, -y, -z+1/2'
7 'y+1/2, x+1/2, -z+1/2'
8 '-y, -x, -z+1/2'
9 '-x, -y, -z'
10 'x+1/2, y+1/2, -z'
11 'y+1/2, -x, -z'
12 '-y, x+1/2, -z'
13 'x, -y+1/2, z+1/2'
14 '-x+1/2, y, z+1/2'
15 '-y+1/2, -x+1/2, z+1/2'
16 'y, x, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Xe     Xe       4     0.750000    0.250000    0.000000 1
Xe     Xe       4     0.250000    0.250000    0.808030 1
Fr     Fr       8     0.943794    0.056206    0.250000 1
Fr     Fr       8     0.017527    0.982473    0.250000 1
Kr     Kr      16     0.121710    0.883112    0.031444 1
#END

