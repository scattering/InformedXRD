data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/m'
_symmetry_Int_Tables_number                   11
_symmetry_cell_setting                monoclinic
_cell_length_a            8.338270
_cell_length_b            5.544730
_cell_length_c            6.152350
_cell_angle_alpha        90.000000
_cell_angle_beta        114.742945
_cell_angle_gamma        90.000000
_cell_volume            258.330931

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z'
3 '-x, -y, -z'
4 'x, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ba     Ba       2     0.500000    0.000000    0.000000 1
Zn     Zn       2     0.777163    0.250000    0.326681 1
Zn     Zn       2     0.011609    0.250000    0.042563 1
Zn     Zn       2     0.240510    0.250000    0.883323 1
Zn     Zn       4     0.720227    0.951878    0.358902 1
Au     Au       2     0.000000    0.000000    0.500000 1
#END

