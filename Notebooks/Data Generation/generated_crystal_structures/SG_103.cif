data_from_pyxtal

_symmetry_space_group_name_H-M 'P4cc'
_symmetry_Int_Tables_number                  103
_symmetry_cell_setting                tetragonal
_cell_length_a            8.088953
_cell_length_b            8.088953
_cell_length_c            7.167170
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            468.956225

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z'
4 'y, -x, z'
5 'x, -y, z+1/2'
6 '-x, y, z+1/2'
7 '-y, -x, z+1/2'
8 'y, x, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
V      V        4     0.000000    0.500000    0.187065 1
V      V        2     0.500000    0.500000    0.802829 1
V      V        2     0.000000    0.000000    0.659349 1
Se     Se       2     0.000000    0.000000    0.400810 1
Cd     Cd       8     0.089588    0.849820    0.967964 1
