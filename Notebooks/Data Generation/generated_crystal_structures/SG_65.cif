data_from_pyxtal

_symmetry_space_group_name_H-M 'Cmmm'
_symmetry_Int_Tables_number                   65
_symmetry_cell_setting              orthorhombic
_cell_length_a            6.820595
_cell_length_b           12.312603
_cell_length_c            9.061967
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            761.017488

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-x, y, -z'
4 'x, -y, -z'
5 '-x, -y, -z'
6 'x, y, -z'
7 'x, -y, z'
8 '-x, y, z'
9 'x+1/2, y+1/2, z'
10 '-x+1/2, -y+1/2, z'
11 '-x+1/2, y+1/2, -z'
12 'x+1/2, -y+1/2, -z'
13 '-x+1/2, -y+1/2, -z'
14 'x+1/2, y+1/2, -z'
15 'x+1/2, -y+1/2, z'
16 '-x+1/2, y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ca     Ca       8     0.000000    0.419625    0.386041 1
Ca     Ca       4     0.250000    0.250000    0.500000 1
Ca     Ca       2     0.500000    0.000000    0.000000 1
Ca     Ca       2     0.000000    0.000000    0.500000 1
Dy     Dy       2     0.000000    0.000000    0.000000 1
Ar     Ar       2     0.500000    0.000000    0.500000 1
