data_from_pyxtal

_symmetry_space_group_name_H-M 'P31c'
_symmetry_Int_Tables_number                  159
_symmetry_cell_setting                  trigonal
_cell_length_a            7.153274
_cell_length_b            7.153274
_cell_length_c            7.072642
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            313.416611

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 'y, x, z+1/2'
5 'x-y, -y, z+1/2'
6 '-x, -x+y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ne     Ne       2     0.000000    0.000000    0.710788 1
Ne     Ne       2     0.000000    0.000000    0.947300 1
Ne     Ne       2     0.333333    0.666667    0.263423 1
Re     Re       2     0.333333    0.666667    0.998127 1
Tc     Tc       6     0.973000    0.368035    0.867760 1
