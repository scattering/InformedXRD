data_from_pyxtal

_symmetry_space_group_name_H-M 'P3'
_symmetry_Int_Tables_number                  143
_symmetry_cell_setting                  trigonal
_cell_length_a            6.928000
_cell_length_b            6.928000
_cell_length_c            5.634418
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            234.204617

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Yb     Yb       3     0.520948    0.892279    0.420448 1
Tm     Tm       1     0.666667    0.333333    0.550895 1
Tm     Tm       1     0.333333    0.666667    0.062107 1
Tm     Tm       1     0.000000    0.000000    0.871694 1
