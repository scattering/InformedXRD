data_from_pyxtal

_symmetry_space_group_name_H-M 'P64'
_symmetry_Int_Tables_number                  172
_symmetry_cell_setting                 hexagonal
_cell_length_a            4.469993
_cell_length_b            4.469993
_cell_length_c           13.070061
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            226.163184

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z+1/3'
3 '-x+y, -x, z+2/3'
4 '-x, -y, z'
5 'y, -x+y, z+1/3'
6 'x-y, x, z+2/3'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ca     Ca       3     0.500000    0.500000    0.761367 1
Ca     Ca       3     0.000000    0.000000    0.467595 1
Pt     Pt       3     0.500000    0.500000    0.922909 1
#END

