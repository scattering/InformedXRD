data_from_pyxtal

_symmetry_space_group_name_H-M 'P42/nmc'
_symmetry_Int_Tables_number                  137
_symmetry_cell_setting                tetragonal
_cell_length_a            4.447413
_cell_length_b            4.447413
_cell_length_c            3.131185
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume             61.933215

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-y+1/2, x, z+1/2'
4 'y, -x+1/2, z+1/2'
5 '-x, y+1/2, -z'
6 'x+1/2, -y, -z'
7 'y+1/2, x+1/2, -z+1/2'
8 '-y, -x, -z+1/2'
9 '-x, -y, -z'
10 'x+1/2, y+1/2, -z'
11 'y+1/2, -x, -z+1/2'
12 '-y, x+1/2, -z+1/2'
13 'x, -y+1/2, z'
14 '-x+1/2, y, z'
15 '-y+1/2, -x+1/2, z+1/2'
16 'y, x, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Au     Au       2     0.750000    0.250000    0.250000 1
S      S        4     0.250000    0.250000    0.230575 1
#END

