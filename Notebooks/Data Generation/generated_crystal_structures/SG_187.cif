data_from_pyxtal

_symmetry_space_group_name_H-M 'P-6m2'
_symmetry_Int_Tables_number                  187
_symmetry_cell_setting                 hexagonal
_cell_length_a           10.903329
_cell_length_b           10.903329
_cell_length_c            5.449352
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            561.039894

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 'x, y, -z'
5 '-y, x-y, -z'
6 '-x+y, -x, -z'
7 '-y, -x, z'
8 '-x+y, y, z'
9 'x, x-y, z'
10 '-y, -x, -z'
11 '-x+y, y, -z'
12 'x, x-y, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
V      V        3     0.745222    0.254778    0.500000 1
Cd     Cd       2     0.666667    0.333333    0.702928 1
Cd     Cd       1     0.333333    0.666667    0.500000 1
Cd     Cd       2     0.333333    0.666667    0.780778 1
Cd     Cd       1     0.000000    0.000000    0.500000 1
Y      Y        3     0.807098    0.192902    0.000000 1
Y      Y        6     0.751189    0.759507    0.500000 1
Y      Y        3     0.545093    0.454907    0.000000 1
