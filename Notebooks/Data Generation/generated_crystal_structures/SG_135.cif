data_from_pyxtal

_symmetry_space_group_name_H-M 'P42/mbc'
_symmetry_Int_Tables_number                  135
_symmetry_cell_setting                tetragonal
_cell_length_a            7.793236
_cell_length_b            7.793236
_cell_length_c            7.628662
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            463.323153

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z+1/2'
4 'y, -x, z+1/2'
5 '-x+1/2, y+1/2, -z'
6 'x+1/2, -y+1/2, -z'
7 'y+1/2, x+1/2, -z+1/2'
8 '-y+1/2, -x+1/2, -z+1/2'
9 '-x, -y, -z'
10 'x, y, -z'
11 'y, -x, -z+1/2'
12 '-y, x, -z+1/2'
13 'x+1/2, -y+1/2, z'
14 '-x+1/2, y+1/2, z'
15 '-y+1/2, -x+1/2, z+1/2'
16 'y+1/2, x+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Po     Po       8     0.510691    0.383672    0.000000 1
Po     Po       8     0.775752    0.898799    0.000000 1
Tl     Tl       4     0.000000    0.500000    0.250000 1
#END

