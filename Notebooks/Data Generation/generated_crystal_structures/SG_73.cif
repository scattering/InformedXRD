data_from_pyxtal

_symmetry_space_group_name_H-M 'Ibca'
_symmetry_Int_Tables_number                   73
_symmetry_cell_setting              orthorhombic
_cell_length_a            7.390512
_cell_length_b           10.426262
_cell_length_c           10.015584
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            771.754980

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z+1/2'
3 '-x, y+1/2, -z+1/2'
4 'x+1/2, -y+1/2, -z'
5 '-x, -y, -z'
6 'x+1/2, y, -z+1/2'
7 'x, -y+1/2, z+1/2'
8 '-x+1/2, y+1/2, z'
9 'x+1/2, y+1/2, z+1/2'
10 '-x+1, -y+1/2, z+1'
11 '-x+1/2, y+1, -z+1'
12 'x+1, -y+1, -z+1/2'
13 '-x+1/2, -y+1/2, -z+1/2'
14 'x+1, y+1/2, -z+1'
15 'x+1/2, -y+1, z+1'
16 '-x+1, y+1, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Nd     Nd       8     0.000000    0.000000    0.000000 1
Be     Be       8     0.000000    0.250000    0.413657 1
Be     Be       8     0.250000    0.738684    0.000000 1
Xe     Xe       8     0.000000    0.250000    0.769446 1
#END

