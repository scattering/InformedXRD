data_from_pyxtal

_symmetry_space_group_name_H-M 'P6'
_symmetry_Int_Tables_number                  168
_symmetry_cell_setting                 hexagonal
_cell_length_a           11.277529
_cell_length_b           11.277529
_cell_length_c            2.677947
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            294.958207

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 '-x, -y, z'
5 'y, -x+y, z'
6 'x-y, x, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Na     Na       6     0.993832    0.281289    0.680429 1
Er     Er       1     0.000000    0.000000    0.278986 1
Er     Er       2     0.333333    0.666667    0.680895 1
