data_from_pyxtal

_symmetry_space_group_name_H-M 'Aem2'
_symmetry_Int_Tables_number                   39
_symmetry_cell_setting              orthorhombic
_cell_length_a            6.262081
_cell_length_b           12.528876
_cell_length_c            7.299914
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            572.728153

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x, -y+1/2, z'
4 '-x, y+1/2, z'
5 'x, y+1/2, z+1/2'
6 '-x, -y+1/2, z+1/2'
7 'x, -y+1, z+1/2'
8 '-x, y+1, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Tl     Tl       8     0.252661    0.045809    0.200190 1
Tl     Tl       4     0.292398    0.250000    0.991904 1
Ge     Ge       4     0.500000    0.000000    0.844155 1
Ge     Ge       8     0.601563    0.901097    0.682903 1
