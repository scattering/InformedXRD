data_from_pyxtal

_symmetry_space_group_name_H-M 'Pn-3n'
_symmetry_Int_Tables_number                  222
_symmetry_cell_setting                     cubic
_cell_length_a           12.834298
_cell_length_b           12.834298
_cell_length_c           12.834298
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           2114.055401

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-x+1/2, y, -z+1/2'
4 'x, -y+1/2, -z+1/2'
5 'z, x, y'
6 'z, -x+1/2, -y+1/2'
7 '-z+1/2, -x+1/2, y'
8 '-z+1/2, x, -y+1/2'
9 'y, z, x'
10 '-y+1/2, z, -x+1/2'
11 'y, -z+1/2, -x+1/2'
12 '-y+1/2, -z+1/2, x'
13 'y, x, -z+1/2'
14 '-y+1/2, -x+1/2, -z+1/2'
15 'y, -x+1/2, z'
16 '-y+1/2, x, z'
17 'x, z, -y+1/2'
18 '-x+1/2, z, y'
19 '-x+1/2, -z+1/2, -y+1/2'
20 'x, -z+1/2, y'
21 'z, y, -x+1/2'
22 'z, -y+1/2, x'
23 '-z+1/2, y, x'
24 '-z+1/2, -y+1/2, -x+1/2'
25 '-x, -y, -z'
26 'x+1/2, y+1/2, -z'
27 'x+1/2, -y, z+1/2'
28 '-x, y+1/2, z+1/2'
29 '-z, -x, -y'
30 '-z, x+1/2, y+1/2'
31 'z+1/2, x+1/2, -y'
32 'z+1/2, -x, y+1/2'
33 '-y, -z, -x'
34 'y+1/2, -z, x+1/2'
35 '-y, z+1/2, x+1/2'
36 'y+1/2, z+1/2, -x'
37 '-y, -x, z+1/2'
38 'y+1/2, x+1/2, z+1/2'
39 '-y, x+1/2, -z'
40 'y+1/2, -x, -z'
41 '-x, -z, y+1/2'
42 'x+1/2, -z, -y'
43 'x+1/2, z+1/2, y+1/2'
44 '-x, z+1/2, -y'
45 '-z, -y, x+1/2'
46 '-z, y+1/2, -x'
47 'z+1/2, -y, -x'
48 'z+1/2, y+1/2, x+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
