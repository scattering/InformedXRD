data_from_pyxtal

_symmetry_space_group_name_H-M 'Pc'
_symmetry_Int_Tables_number                    7
_symmetry_cell_setting                monoclinic
_cell_length_a            4.472409
_cell_length_b            5.181675
_cell_length_c            3.170892
_cell_angle_alpha        90.000000
_cell_angle_beta         93.143158
_cell_angle_gamma        90.000000
_cell_volume             73.373521

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x, -y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Rn     Rn       2     0.375981    0.249584    0.393080 1
Br     Br       2     0.710196    0.634005    0.106009 1
#END

