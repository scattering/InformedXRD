9 'y, z, x'
10 '-y+1/2, z, -x+1/2'
11 'y, -z+1/2, -x+1/2'
12 '-y+1/2, -z+1/2, x'
13 'y+1/2, x+1/2, -z'
14 '-y, -x, -z'
15 'y+1/2, -x, z+1/2'
16 '-y, x+1/2, z+1/2'
17 'x+1/2, z+1/2, -y'
18 '-x, z+1/2, y+1/2'
19 '-x, -z, -y'
20 'x+1/2, -z, y+1/2'
21 'z+1/2, y+1/2, -x'
22 'z+1/2, -y, x+1/2'
23 '-z, y+1/2, x+1/2'
24 '-z, -y, -x'
25 '-x, -y, -z'
26 'x+1/2, y+1/2, -z'
27 'x+1/2, -y, z+1/2'
28 '-x, y+1/2, z+1/2'
29 '-z, -x, -y'
30 '-z, x+1/2, y+1/2'
31 'z+1/2, x+1/2, -y'
32 'z+1/2, -x, y+1/2'
33 '-y, -z, -x'
34 'y+1/2, -z, x+1/2'
35 '-y, z+1/2, x+1/2'
36 'y+1/2, z+1/2, -x'
37 '-y+1/2, -x+1/2, z'
38 'y, x, z'
39 '-y+1/2, x, -z+1/2'
40 'y, -x+1/2, -z+1/2'
41 '-x+1/2, -z+1/2, y'
42 'x, -z+1/2, -y+1/2'
43 'x, z, y'
44 '-x+1/2, z, -y+1/2'
45 '-z+1/2, -y+1/2, x'
46 '-z+1/2, y, -x+1/2'
47 'z, -y+1/2, -x+1/2'
48 'z, y, x'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
