data_from_pyxtal

_symmetry_space_group_name_H-M 'Pnn2'
_symmetry_Int_Tables_number                   34
_symmetry_cell_setting              orthorhombic
_cell_length_a            5.456224
_cell_length_b            6.354482
_cell_length_c           10.451293
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            362.361753

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/2, -y+1/2, z+1/2'
4 '-x+1/2, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Pr     Pr       4     0.388308    0.326003    0.367925 1
Pm     Pm       2     0.000000    0.500000    0.522759 1
Pm     Pm       2     0.000000    0.000000    0.386581 1
Rh     Rh       2     0.000000    0.500000    0.693333 1
#END

