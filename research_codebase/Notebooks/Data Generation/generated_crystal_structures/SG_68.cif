data_from_pyxtal

_symmetry_space_group_name_H-M 'Ccce'
_symmetry_Int_Tables_number                   68
_symmetry_cell_setting              orthorhombic
_cell_length_a            8.672671
_cell_length_b            6.406399
_cell_length_c            8.141161
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            452.327751

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z'
3 '-x, y, -z+1/2'
4 'x+1/2, -y, -z+1/2'
5 '-x, -y, -z'
6 'x+1/2, y, -z'
7 'x, -y, z+1/2'
8 '-x+1/2, y, z+1/2'
9 'x+1/2, y+1/2, z'
10 '-x+1, -y+1/2, z'
11 '-x+1/2, y+1/2, -z+1/2'
12 'x+1, -y+1/2, -z+1/2'
13 '-x+1/2, -y+1/2, -z'
14 'x+1, y+1/2, -z'
15 'x+1/2, -y+1/2, z+1/2'
16 '-x+1, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
S      S        8     0.250000    0.000000    0.677614 1
Xe     Xe       8     0.250000    0.750000    0.000000 1
Er     Er       4     0.000000    0.250000    0.250000 1
#END

