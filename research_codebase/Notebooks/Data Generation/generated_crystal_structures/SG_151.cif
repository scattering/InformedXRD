data_from_pyxtal

_symmetry_space_group_name_H-M 'P3112'
_symmetry_Int_Tables_number                  151
_symmetry_cell_setting                  trigonal
_cell_length_a            9.797132
_cell_length_b            9.797132
_cell_length_c            3.281491
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            272.772004

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z+1/3'
3 '-x+y, -x, z+2/3'
4 '-y, -x, -z+2/3'
5 '-x+y, y, -z+1/3'
6 'x, x-y, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Hg     Hg       3     0.952274    0.047726    0.833333 1
Pt     Pt       6     0.649609    0.690272    0.239326 1
Fe     Fe       3     0.720435    0.279565    0.333333 1
Fe     Fe       3     0.765139    0.234861    0.833333 1
