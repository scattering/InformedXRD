data_from_pyxtal

_symmetry_space_group_name_H-M 'P4/nnc'
_symmetry_Int_Tables_number                  126
_symmetry_cell_setting                tetragonal
_cell_length_a           11.833399
_cell_length_b           11.833399
_cell_length_c           13.519518
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           1893.129185

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-y+1/2, x, z'
4 'y, -x+1/2, z'
5 '-x+1/2, y, -z+1/2'
6 'x, -y+1/2, -z+1/2'
7 'y, x, -z+1/2'
8 '-y+1/2, -x+1/2, -z+1/2'
9 '-x, -y, -z'
10 'x+1/2, y+1/2, -z'
11 'y+1/2, -x, -z'
12 '-y, x+1/2, -z'
13 'x+1/2, -y, z+1/2'
14 '-x, y+1/2, z+1/2'
15 '-y, -x, z+1/2'
16 'y+1/2, x+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ac     Ac       8     0.000000    0.000000    0.000000 1
Ac     Ac       4     0.250000    0.750000    0.000000 1
Ac     Ac       2     0.250000    0.250000    0.750000 1
Ac     Ac       2     0.250000    0.250000    0.250000 1
Os     Os       8     0.088135    0.750000    0.250000 1
Sr     Sr      16     0.695031    0.958978    0.621473 1
