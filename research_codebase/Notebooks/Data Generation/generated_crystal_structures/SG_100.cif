data_from_pyxtal

_symmetry_space_group_name_H-M 'P4bm'
_symmetry_Int_Tables_number                  100
_symmetry_cell_setting                tetragonal
_cell_length_a            6.048094
_cell_length_b            6.048094
_cell_length_c            3.124203
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            114.281600

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z'
4 'y, -x, z'
5 'x+1/2, -y+1/2, z'
6 '-x+1/2, y+1/2, z'
7 '-y+1/2, -x+1/2, z'
8 'y+1/2, x+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ta     Ta       2     0.000000    0.000000    0.158933 1
Ag     Ag       4     0.878052    1.378052    0.243565 1
#END

