data_from_pyxtal

_symmetry_space_group_name_H-M 'I4/mcm'
_symmetry_Int_Tables_number                  140
_symmetry_cell_setting                tetragonal
_cell_length_a            6.588553
_cell_length_b            6.588553
_cell_length_c           19.304849
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            838.004741

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z'
4 'y, -x, z'
5 '-x, y, -z+1/2'
6 'x, -y, -z+1/2'
7 'y, x, -z+1/2'
8 '-y, -x, -z+1/2'
9 '-x, -y, -z'
10 'x, y, -z'
11 'y, -x, -z'
12 '-y, x, -z'
13 'x, -y, z+1/2'
14 '-x, y, z+1/2'
15 '-y, -x, z+1/2'
16 'y, x, z+1/2'
17 'x+1/2, y+1/2, z+1/2'
18 '-x+1/2, -y+1/2, z+1/2'
19 '-y+1/2, x+1/2, z+1/2'
20 'y+1/2, -x+1/2, z+1/2'
21 '-x+1/2, y+1/2, -z+1'
22 'x+1/2, -y+1/2, -z+1'
23 'y+1/2, x+1/2, -z+1'
24 '-y+1/2, -x+1/2, -z+1'
25 '-x+1/2, -y+1/2, -z+1/2'
26 'x+1/2, y+1/2, -z+1/2'
27 'y+1/2, -x+1/2, -z+1/2'
28 '-y+1/2, x+1/2, -z+1/2'
29 'x+1/2, -y+1/2, z+1'
30 '-x+1/2, y+1/2, z+1'
31 '-y+1/2, -x+1/2, z+1'
32 'y+1/2, x+1/2, z+1'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Nb     Nb      16     0.147895    0.647895    0.781528 1
Zn     Zn      32     0.134731    0.139311    0.929643 1
Ne     Ne       8     0.000000    0.500000    0.636284 1
Ne     Ne       8     0.250000    0.250000    0.250000 1
