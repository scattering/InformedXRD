data_from_pyxtal

_symmetry_space_group_name_H-M 'P42/mcm'
_symmetry_Int_Tables_number                  132
_symmetry_cell_setting                tetragonal
_cell_length_a            9.506563
_cell_length_b            9.506563
_cell_length_c            9.681536
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            874.966220

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z+1/2'
4 'y, -x, z+1/2'
5 '-x, y, -z+1/2'
6 'x, -y, -z+1/2'
7 'y, x, -z'
8 '-y, -x, -z'
9 '-x, -y, -z'
10 'x, y, -z'
11 'y, -x, -z+1/2'
12 '-y, x, -z+1/2'
13 'x, -y, z+1/2'
14 '-x, y, z+1/2'
15 '-y, -x, z'
16 'y, x, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Na     Na       8     0.846360    0.846360    0.781301 1
Na     Na       4     0.105407    0.105407    0.500000 1
Na     Na       4     0.410419    0.410419    0.000000 1
Tb     Tb       4     0.000000    0.500000    0.250000 1
Fr     Fr       2     0.500000    0.500000    0.250000 1
#END

