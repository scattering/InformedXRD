data_from_pyxtal

_symmetry_space_group_name_H-M 'R-3c'
_symmetry_Int_Tables_number                  167
_symmetry_cell_setting                  trigonal
_cell_length_a           13.458654
_cell_length_b           13.458654
_cell_length_c           15.579654
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume           2443.946458

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 'y, x, -z+1/2'
5 'x-y, -y, -z+1/2'
6 '-x, -x+y, -z+1/2'
7 '-x, -y, -z'
8 'y, -x+y, -z'
9 'x-y, x, -z'
10 '-y, -x, z+1/2'
11 '-x+y, y, z+1/2'
12 'x, x-y, z+1/2'
13 'x+2/3, y+1/3, z+1/3'
14 '-y+2/3, x-y+1/3, z+1/3'
15 '-x+y+2/3, -x+1/3, z+1/3'
16 'y+2/3, x+1/3, -z+5/6'
17 'x-y+2/3, -y+1/3, -z+5/6'
18 '-x+2/3, -x+y+1/3, -z+5/6'
19 '-x+2/3, -y+1/3, -z+1/3'
20 'y+2/3, -x+y+1/3, -z+1/3'
21 'x-y+2/3, x+1/3, -z+1/3'
22 '-y+2/3, -x+1/3, z+5/6'
23 '-x+y+2/3, y+1/3, z+5/6'
24 'x+2/3, x-y+1/3, z+5/6'
25 'x+1/3, y+2/3, z+2/3'
26 '-y+1/3, x-y+2/3, z+2/3'
27 '-x+y+1/3, -x+2/3, z+2/3'
28 'y+1/3, x+2/3, -z+7/6'
29 'x-y+1/3, -y+2/3, -z+7/6'
30 '-x+1/3, -x+y+2/3, -z+7/6'
31 '-x+1/3, -y+2/3, -z+2/3'
32 'y+1/3, -x+y+2/3, -z+2/3'
33 'x-y+1/3, x+2/3, -z+2/3'
34 '-y+1/3, -x+2/3, z+7/6'
35 '-x+y+1/3, y+2/3, z+7/6'
36 'x+1/3, x-y+2/3, z+7/6'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
