data_from_pyxtal

_symmetry_space_group_name_H-M 'P42/nbc'
_symmetry_Int_Tables_number                  133
_symmetry_cell_setting                tetragonal
_cell_length_a            6.404410
_cell_length_b            6.404410
_cell_length_c           37.894133
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           1554.283653

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-y+1/2, x, z+1/2'
4 'y, -x+1/2, z+1/2'
5 '-x+1/2, y, -z'
6 'x, -y+1/2, -z'
7 'y, x, -z+1/2'
8 '-y+1/2, -x+1/2, -z+1/2'
9 '-x, -y, -z'
10 'x+1/2, y+1/2, -z'
11 'y+1/2, -x, -z+1/2'
12 '-y, x+1/2, -z+1/2'
13 'x+1/2, -y, z'
14 '-x, y+1/2, z'
15 '-y, -x, z+1/2'
16 'y+1/2, x+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O       16     0.210276    0.396989    0.788607 1
O      O       16     0.551933    0.211234    0.761227 1
O      O        8     0.000000    0.000000    0.000000 1
O      O        4     0.750000    0.250000    0.000000 1
O      O        4     0.250000    0.250000    0.000000 1
Gd     Gd       4     0.250000    0.250000    0.250000 1
Gd     Gd       8     0.504285    0.250000    0.000000 1
Nb     Nb      16     0.539048    0.866987    0.166287 1
