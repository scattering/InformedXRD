data_from_pyxtal

_symmetry_space_group_name_H-M 'Pba2'
_symmetry_Int_Tables_number                   32
_symmetry_cell_setting              orthorhombic
_cell_length_a            8.687674
_cell_length_b            3.096932
_cell_length_c            6.533250
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            175.777964

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/2, -y+1/2, z'
4 '-x+1/2, y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Pt     Pt       2     0.000000    0.000000    0.597014 1
Pt     Pt       2     0.000000    0.500000    0.827089 1
Nb     Nb       2     0.000000    0.500000    0.331742 1
Nb     Nb       2     0.000000    0.000000    0.207402 1
O      O        4     0.738986    0.602084    0.375536 1
#END

