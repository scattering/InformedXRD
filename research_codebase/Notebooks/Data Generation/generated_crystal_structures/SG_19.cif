data_from_pyxtal

_symmetry_space_group_name_H-M 'P212121'
_symmetry_Int_Tables_number                   19
_symmetry_cell_setting              orthorhombic
_cell_length_a            4.366074
_cell_length_b            5.718973
_cell_length_c            5.739361
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            143.308759

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z+1/2'
3 '-x, y+1/2, -z+1/2'
4 'x+1/2, -y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Mg     Mg       4     0.066886    0.577869    0.281324 1
Al     Al       4     0.642483    0.336906    0.276621 1
#END

