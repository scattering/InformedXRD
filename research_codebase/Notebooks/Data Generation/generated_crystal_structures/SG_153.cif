data_from_pyxtal

_symmetry_space_group_name_H-M 'P3212'
_symmetry_Int_Tables_number                  153
_symmetry_cell_setting                  trigonal
_cell_length_a            7.040866
_cell_length_b            7.040866
_cell_length_c            3.958933
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            169.965589

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z+2/3'
3 '-x+y, -x, z+1/3'
4 '-y, -x, -z+1/3'
5 '-x+y, y, -z+2/3'
6 'x, x-y, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Zn     Zn       3     0.856430    0.143570    0.666667 1
Al     Al       6     0.942773    0.663572    0.998797 1
#END

