data_from_pyxtal

_symmetry_space_group_name_H-M 'P6222'
_symmetry_Int_Tables_number                  180
_symmetry_cell_setting                 hexagonal
_cell_length_a           18.108749
_cell_length_b           18.108749
_cell_length_c            7.375643
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume           2094.630569

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z+2/3'
3 '-x+y, -x, z+1/3'
4 '-x, -y, z'
5 'y, -x+y, z+2/3'
6 'x-y, x, z+1/3'
7 'y, x, -z+2/3'
8 'x-y, -y, -z'
9 '-x, -x+y, -z+1/3'
10 '-y, -x, -z+2/3'
11 '-x+y, y, -z'
12 'x, x-y, -z+1/3'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ac     Ac       3     0.500000    0.000000    0.000000 1
Ac     Ac       3     0.000000    0.000000    0.500000 1
Tm     Tm       6     0.104920    0.000000    0.000000 1
Tm     Tm      12     0.685930    0.451299    0.900212 1
Hf     Hf       6     0.084180    0.168359    0.500000 1
Hf     Hf      12     0.424808    0.347084    0.984145 1
Hf     Hf       6     0.500000    0.000000    0.373845 1
Hf     Hf       6     0.839203    0.678406    0.500000 1
Hf     Hf       6     0.111337    0.000000    0.500000 1
#END

