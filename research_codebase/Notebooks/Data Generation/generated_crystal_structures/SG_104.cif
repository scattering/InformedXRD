data_from_pyxtal

_symmetry_space_group_name_H-M 'P4nc'
_symmetry_Int_Tables_number                  104
_symmetry_cell_setting                tetragonal
_cell_length_a            5.640163
_cell_length_b            5.640163
_cell_length_c           14.199143
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            451.695136

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z'
4 'y, -x, z'
5 'x+1/2, -y+1/2, z+1/2'
6 '-x+1/2, y+1/2, z+1/2'
7 '-y+1/2, -x+1/2, z+1/2'
8 'y+1/2, x+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Tm     Tm       4     0.000000    0.500000    0.584806 1
Tm     Tm       2     0.000000    0.000000    0.592133 1
Tm     Tm       2     0.000000    0.000000    0.300311 1
Hg     Hg       8     0.202027    0.762595    0.873808 1
Ne     Ne       8     0.430689    0.715169    0.026838 1
