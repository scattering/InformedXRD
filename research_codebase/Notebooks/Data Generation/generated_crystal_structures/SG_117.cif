data_from_pyxtal

_symmetry_space_group_name_H-M 'P-4b2'
_symmetry_Int_Tables_number                  117
_symmetry_cell_setting                tetragonal
_cell_length_a            8.303066
_cell_length_b            8.303066
_cell_length_c            4.400810
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            303.395772

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'y, -x, -z'
4 '-y, x, -z'
5 'x+1/2, -y+1/2, z'
6 '-x+1/2, y+1/2, z'
7 'y+1/2, x+1/2, -z'
8 '-y+1/2, -x+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Be     Be       2     0.000000    0.500000    0.000000 1
Fe     Fe       8     0.631364    0.182345    0.706570 1
#END

