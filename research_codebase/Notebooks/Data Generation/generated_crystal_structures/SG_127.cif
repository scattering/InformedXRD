data_from_pyxtal

_symmetry_space_group_name_H-M 'P4/mbm'
_symmetry_Int_Tables_number                  127
_symmetry_cell_setting                tetragonal
_cell_length_a            5.070572
_cell_length_b            5.070572
_cell_length_c           19.810486
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            509.341463

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z'
4 'y, -x, z'
5 '-x+1/2, y+1/2, -z'
6 'x+1/2, -y+1/2, -z'
7 'y+1/2, x+1/2, -z'
8 '-y+1/2, -x+1/2, -z'
9 '-x, -y, -z'
10 'x, y, -z'
11 'y, -x, -z'
12 '-y, x, -z'
13 'x+1/2, -y+1/2, z'
14 '-x+1/2, y+1/2, z'
15 '-y+1/2, -x+1/2, z'
16 'y+1/2, x+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ti     Ti       2     0.000000    0.000000    0.000000 1
Ti     Ti       4     0.133441    0.633441    0.500000 1
Ti     Ti       2     0.000000    0.500000    0.000000 1
Ti     Ti       4     0.000000    0.500000    0.837922 1
Ti     Ti       4     0.000000    0.500000    0.325557 1
Hf     Hf       4     0.000000    0.000000    0.856693 1
