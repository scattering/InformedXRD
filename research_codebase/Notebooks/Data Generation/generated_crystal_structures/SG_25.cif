data_from_pyxtal

_symmetry_space_group_name_H-M 'Pmm2'
_symmetry_Int_Tables_number                   25
_symmetry_cell_setting              orthorhombic
_cell_length_a            5.697264
_cell_length_b            5.594432
_cell_length_c            7.079086
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            225.631362

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x, -y, z'
4 '-x, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Os     Os       2     0.349119    0.500000    0.243812 1
Ar     Ar       4     0.144414    0.778289    0.717373 1
Ni     Ni       4     0.138772    0.878342    0.496065 1
#END

