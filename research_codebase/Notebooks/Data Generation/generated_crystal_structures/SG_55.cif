data_from_pyxtal

_symmetry_space_group_name_H-M 'Pbam'
_symmetry_Int_Tables_number                   55
_symmetry_cell_setting              orthorhombic
_cell_length_a            6.090714
_cell_length_b            8.497628
_cell_length_c            8.260971
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            427.559964

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-x+1/2, y+1/2, -z'
4 'x+1/2, -y+1/2, -z'
5 '-x, -y, -z'
6 'x, y, -z'
7 'x+1/2, -y+1/2, z'
8 '-x+1/2, y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Mg     Mg       8     0.967814    0.214723    0.722729 1
Co     Co       4     0.000000    0.000000    0.358104 1
Fr     Fr       2     0.000000    0.500000    0.500000 1
#END

