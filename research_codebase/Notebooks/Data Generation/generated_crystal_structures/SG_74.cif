data_from_pyxtal

_symmetry_space_group_name_H-M 'Imma'
_symmetry_Int_Tables_number                   74
_symmetry_cell_setting              orthorhombic
_cell_length_a            8.514775
_cell_length_b            6.993264
_cell_length_c           16.341030
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            973.044158

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y+1/2, z'
3 '-x, y+1/2, -z'
4 'x, -y, -z'
5 '-x, -y, -z'
6 'x, y+1/2, -z'
7 'x, -y+1/2, z'
8 '-x, y, z'
9 'x+1/2, y+1/2, z+1/2'
10 '-x+1/2, -y+1, z+1/2'
11 '-x+1/2, y+1, -z+1/2'
12 'x+1/2, -y+1/2, -z+1/2'
13 '-x+1/2, -y+1/2, -z+1/2'
14 'x+1/2, y+1, -z+1/2'
15 'x+1/2, -y+1, z+1/2'
16 '-x+1/2, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Fr     Fr       4     0.000000    0.000000    0.500000 1
K      K        4     0.250000    0.250000    0.750000 1
Hg     Hg       4     0.250000    0.250000    0.250000 1
Hg     Hg       4     0.000000    0.250000    0.428490 1
Hg     Hg       8     0.000000    0.421024    0.214048 1
