data_from_pyxtal

_symmetry_space_group_name_H-M 'Aea2'
_symmetry_Int_Tables_number                   41
_symmetry_cell_setting              orthorhombic
_cell_length_a           14.302110
_cell_length_b            7.116931
_cell_length_c            6.519354
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            663.586322

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/2, -y+1/2, z'
4 '-x+1/2, y+1/2, z'
5 'x, y+1/2, z+1/2'
6 '-x, -y+1/2, z+1/2'
7 'x+1/2, -y+1, z+1/2'
8 '-x+1/2, y+1, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Xe     Xe       4     0.000000    0.000000    0.763482 1
Xe     Xe       4     0.000000    0.000000    0.202971 1
Po     Po       8     0.194417    0.088509    0.685349 1
Si     Si       8     0.893456    0.327411    0.300810 1
