data_from_pyxtal

_symmetry_space_group_name_H-M 'P2/m'
_symmetry_Int_Tables_number                   10
_symmetry_cell_setting                monoclinic
_cell_length_a            5.943648
_cell_length_b            6.240703
_cell_length_c            7.431280
_cell_angle_alpha        90.000000
_cell_angle_beta         67.869081
_cell_angle_gamma        90.000000
_cell_volume            255.337033

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 '-x, -y, -z'
4 'x, -y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ar     Ar       2     0.258810    0.000000    0.969795 1
Rb     Rb       1     0.000000    0.500000    0.500000 1
Rb     Rb       1     0.500000    0.500000    0.500000 1
#END

