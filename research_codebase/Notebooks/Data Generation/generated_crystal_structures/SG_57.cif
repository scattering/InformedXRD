data_from_pyxtal

_symmetry_space_group_name_H-M 'Pbcm'
_symmetry_Int_Tables_number                   57
_symmetry_cell_setting              orthorhombic
_cell_length_a            6.907577
_cell_length_b           10.635373
_cell_length_c            8.189448
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            601.635015

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z+1/2'
3 '-x, y+1/2, -z+1/2'
4 'x, -y+1/2, -z'
5 '-x, -y, -z'
6 'x, y, -z+1/2'
7 'x, -y+1/2, z+1/2'
8 '-x, y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Sn     Sn       4     0.894992    0.250000    0.000000 1
Tb     Tb       4     0.129183    0.228050    0.250000 1
Tb     Tb       4     0.215637    0.704343    0.250000 1
Ra     Ra       4     0.500000    0.000000    0.000000 1
#END

