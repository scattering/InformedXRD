data_from_pyxtal

_symmetry_space_group_name_H-M 'Pnnm'
_symmetry_Int_Tables_number                   58
_symmetry_cell_setting              orthorhombic
_cell_length_a            5.303866
_cell_length_b            5.066770
_cell_length_c           12.103040
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            325.250706

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-x+1/2, y+1/2, -z+1/2'
4 'x+1/2, -y+1/2, -z+1/2'
5 '-x, -y, -z'
6 'x, y, -z'
7 'x+1/2, -y+1/2, z+1/2'
8 '-x+1/2, y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Po     Po       4     0.000000    0.000000    0.297183 1
Po     Po       2     0.000000    0.500000    0.500000 1
N      N        2     0.000000    0.000000    0.000000 1
N      N        2     0.000000    0.000000    0.500000 1
N      N        2     0.000000    0.500000    0.000000 1
Kr     Kr       4     0.637284    0.236596    0.000000 1
