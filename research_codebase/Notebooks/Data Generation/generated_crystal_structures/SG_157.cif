data_from_pyxtal

_symmetry_space_group_name_H-M 'P31m'
_symmetry_Int_Tables_number                  157
_symmetry_cell_setting                  trigonal
_cell_length_a            7.420806
_cell_length_b            7.420806
_cell_length_c            7.090916
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            338.170035

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 'y, x, z'
5 'x-y, -y, z'
6 '-x, -x+y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Pm     Pm       3     0.187576    0.000000    0.251891 1
Sm     Sm       3     0.530457    0.000000    0.591391 1
U      U        1     0.000000    0.000000    0.973439 1
U      U        2     0.333333    0.666667    0.347327 1
#END

