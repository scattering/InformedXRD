data_from_pyxtal

_symmetry_space_group_name_H-M 'P3c1'
_symmetry_Int_Tables_number                  158
_symmetry_cell_setting                  trigonal
_cell_length_a            4.855421
_cell_length_b            4.855421
_cell_length_c           14.436953
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            294.754144

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z'
3 '-x+y, -x, z'
4 '-y, -x, z+1/2'
5 '-x+y, y, z+1/2'
6 'x, x-y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Yb     Yb       2     0.333333    0.666667    0.172546 1
Al     Al       2     0.000000    0.000000    0.198210 1
Hf     Hf       6     0.364253    0.001985    0.598910 1
#END

