data_from_pyxtal

_symmetry_space_group_name_H-M 'I213'
_symmetry_Int_Tables_number                  199
_symmetry_cell_setting                     cubic
_cell_length_a           11.679286
_cell_length_b           11.679286
_cell_length_c           11.679286
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           1593.121528

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z+1/2'
3 '-x, y+1/2, -z+1/2'
4 'x+1/2, -y+1/2, -z'
5 'z, x, y'
6 'z+1/2, -x+1/2, -y'
7 '-z+1/2, -x, y+1/2'
8 '-z, x+1/2, -y+1/2'
9 'y, z, x'
10 '-y, z+1/2, -x+1/2'
11 'y+1/2, -z+1/2, -x'
12 '-y+1/2, -z, x+1/2'
13 'x+1/2, y+1/2, z+1/2'
14 '-x+1, -y+1/2, z+1'
15 '-x+1/2, y+1, -z+1'
16 'x+1, -y+1, -z+1/2'
17 'z+1/2, x+1/2, y+1/2'
18 'z+1, -x+1, -y+1/2'
19 '-z+1, -x+1/2, y+1'
20 '-z+1/2, x+1, -y+1'
21 'y+1/2, z+1/2, x+1/2'
22 '-y+1/2, z+1, -x+1'
23 'y+1, -z+1, -x+1/2'
24 '-y+1, -z+1/2, x+1'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ti     Ti       8     0.515051    0.515051    0.515051 1
Cs     Cs      12     0.197608    0.000000    0.250000 1
#END

