data_from_pyxtal

_symmetry_space_group_name_H-M 'I4cm'
_symmetry_Int_Tables_number                  108
_symmetry_cell_setting                tetragonal
_cell_length_a            5.613207
_cell_length_b            5.613207
_cell_length_c           15.757078
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            496.475403

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z'
4 'y, -x, z'
5 'x, -y, z+1/2'
6 '-x, y, z+1/2'
7 '-y, -x, z+1/2'
8 'y, x, z+1/2'
9 'x+1/2, y+1/2, z+1/2'
10 '-x+1/2, -y+1/2, z+1/2'
11 '-y+1/2, x+1/2, z+1/2'
12 'y+1/2, -x+1/2, z+1/2'
13 'x+1/2, -y+1/2, z+1'
14 '-x+1/2, y+1/2, z+1'
15 '-y+1/2, -x+1/2, z+1'
16 'y+1/2, x+1/2, z+1'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Co     Co      16     0.339641    0.598870    0.285771 1
P      P        4     0.500000    0.000000    0.031849 1
#END

