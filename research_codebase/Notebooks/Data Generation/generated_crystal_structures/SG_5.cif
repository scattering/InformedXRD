data_from_pyxtal

_symmetry_space_group_name_H-M 'C2'
_symmetry_Int_Tables_number                    5
_symmetry_cell_setting                monoclinic
_cell_length_a            3.117656
_cell_length_b            9.956424
_cell_length_c            6.660160
_cell_angle_alpha        90.000000
_cell_angle_beta         71.114929
_cell_angle_gamma        90.000000
_cell_volume            195.607395

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 'x+1/2, y+1/2, z'
4 '-x+1/2, y+1/2, -z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ac     Ac       2     0.000000    0.058163    0.000000 1
V      V        2     0.000000    0.856059    0.500000 1
F      F        4     0.616192    0.554431    0.602935 1
#END

