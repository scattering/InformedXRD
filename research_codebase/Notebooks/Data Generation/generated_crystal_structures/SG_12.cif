data_from_pyxtal

_symmetry_space_group_name_H-M 'C2/m'
_symmetry_Int_Tables_number                   12
_symmetry_cell_setting                monoclinic
_cell_length_a           13.469411
_cell_length_b            6.630345
_cell_length_c            7.549909
_cell_angle_alpha        90.000000
_cell_angle_beta        118.829423
_cell_angle_gamma        90.000000
_cell_volume            590.690385

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y, -z'
3 '-x, -y, -z'
4 'x, -y, z'
5 'x+1/2, y+1/2, z'
6 '-x+1/2, y+1/2, -z'
7 '-x+1/2, -y+1/2, -z'
8 'x+1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Yb     Yb       4     0.596840    0.000000    0.410365 1
Yb     Yb       2     0.000000    0.500000    0.000000 1
Yb     Yb       2     0.000000    0.000000    0.000000 1
Tb     Tb       4     0.250000    0.250000    0.500000 1
Tb     Tb       4     0.250000    0.250000    0.000000 1
Pd     Pd       2     0.000000    0.500000    0.500000 1
