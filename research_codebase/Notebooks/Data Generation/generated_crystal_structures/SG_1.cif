data_from_pyxtal

_symmetry_space_group_name_H-M 'P1'
_symmetry_Int_Tables_number                    1
_symmetry_cell_setting                 triclinic
_cell_length_a            7.671963
_cell_length_b            5.949690
_cell_length_c            9.106154
_cell_angle_alpha        83.623467
_cell_angle_beta        117.214599
_cell_angle_gamma       113.719287
_cell_volume            337.060187

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
