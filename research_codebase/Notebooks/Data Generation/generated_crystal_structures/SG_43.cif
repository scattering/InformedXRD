data_from_pyxtal

_symmetry_space_group_name_H-M 'Fdd2'
_symmetry_Int_Tables_number                   43
_symmetry_cell_setting              orthorhombic
_cell_length_a            9.626176
_cell_length_b            7.835702
_cell_length_c           11.850104
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            893.827740

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/4, -y+1/4, z+1/4'
4 '-x+1/4, y+1/4, z+1/4'
5 'x, y+1/2, z+1/2'
6 '-x, -y+1/2, z+1/2'
7 'x+1/4, -y+3/4, z+3/4'
8 '-x+1/4, y+3/4, z+3/4'
9 'x+1/2, y, z+1/2'
10 '-x+1/2, -y, z+1/2'
11 'x+3/4, -y+1/4, z+3/4'
12 '-x+3/4, y+1/4, z+3/4'
13 'x+1/2, y+1/2, z'
14 '-x+1/2, -y+1/2, z'
15 'x+3/4, -y+3/4, z+1/4'
16 '-x+3/4, y+3/4, z+1/4'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Rn     Rn       8     0.000000    0.000000    0.226870 1
Si     Si      16     0.441643    0.660822    0.277428 1
Ru     Ru      16     0.682666    0.834335    0.830781 1
#END

