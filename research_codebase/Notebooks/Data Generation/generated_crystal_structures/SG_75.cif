data_from_pyxtal

_symmetry_space_group_name_H-M 'P4'
_symmetry_Int_Tables_number                   75
_symmetry_cell_setting                tetragonal
_cell_length_a            9.493608
_cell_length_b            9.493608
_cell_length_c            3.039103
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            273.910054

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z'
4 'y, -x, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Au     Au       4     0.409569    0.274189    0.490739 1
V      V        4     0.564117    0.089299    0.842493 1
Tm     Tm       1     0.500000    0.500000    0.835498 1
Tm     Tm       1     0.000000    0.000000    0.645644 1
#END

