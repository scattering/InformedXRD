data_from_pyxtal

_symmetry_space_group_name_H-M 'Ibam'
_symmetry_Int_Tables_number                   72
_symmetry_cell_setting              orthorhombic
_cell_length_a           15.359194
_cell_length_b            9.492283
_cell_length_c           10.797578
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           1574.220081

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-x+1/2, y+1/2, -z'
4 'x+1/2, -y+1/2, -z'
5 '-x, -y, -z'
6 'x, y, -z'
7 'x+1/2, -y+1/2, z'
8 '-x+1/2, y+1/2, z'
9 'x+1/2, y+1/2, z+1/2'
10 '-x+1/2, -y+1/2, z+1/2'
11 '-x+1, y+1, -z+1/2'
12 'x+1, -y+1, -z+1/2'
13 '-x+1/2, -y+1/2, -z+1/2'
14 'x+1/2, y+1/2, -z+1/2'
15 'x+1, -y+1, z+1/2'
16 '-x+1, y+1, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Ba     Ba      16     0.304654    0.252535    0.666749 1
Xe     Xe       8     0.000000    0.725879    0.250000 1
#END

