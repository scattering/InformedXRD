data_from_pyxtal

_symmetry_space_group_name_H-M 'P31'
_symmetry_Int_Tables_number                  144
_symmetry_cell_setting                  trigonal
_cell_length_a            8.083778
_cell_length_b            8.083778
_cell_length_c            7.829260
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume            443.077887

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z+1/3'
3 '-x+y, -x, z+2/3'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Nd     Nd       3     0.838682    0.762303    0.261758 1
Li     Li       3     0.428860    0.999356    0.552846 1
Rb     Rb       3     0.925913    0.930632    0.530015 1
#END

