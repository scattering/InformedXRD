data_from_pyxtal

_symmetry_space_group_name_H-M 'P42/n'
_symmetry_Int_Tables_number                   86
_symmetry_cell_setting                tetragonal
_cell_length_a           11.265038
_cell_length_b           11.265038
_cell_length_c            6.780208
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            860.415707

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-y, x+1/2, z+1/2'
4 'y+1/2, -x, z+1/2'
5 '-x, -y, -z'
6 'x+1/2, y+1/2, -z'
7 'y, -x+1/2, -z+1/2'
8 '-y+1/2, x, -z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Fe     Fe       2     0.250000    0.250000    0.750000 1
Ba     Ba       8     0.664616    0.612034    0.655367 1
Ag     Ag       8     0.816397    0.204421    0.475760 1
#END

