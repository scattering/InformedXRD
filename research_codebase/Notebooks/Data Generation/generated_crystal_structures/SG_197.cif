data_from_pyxtal

_symmetry_space_group_name_H-M 'I23'
_symmetry_Int_Tables_number                  197
_symmetry_cell_setting                     cubic
_cell_length_a            7.760647
_cell_length_b            7.760647
_cell_length_c            7.760647
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            467.405488

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-x, y, -z'
4 'x, -y, -z'
5 'z, x, y'
6 'z, -x, -y'
7 '-z, -x, y'
8 '-z, x, -y'
9 'y, z, x'
10 '-y, z, -x'
11 'y, -z, -x'
12 '-y, -z, x'
13 'x+1/2, y+1/2, z+1/2'
14 '-x+1/2, -y+1/2, z+1/2'
15 '-x+1/2, y+1/2, -z+1/2'
16 'x+1/2, -y+1/2, -z+1/2'
17 'z+1/2, x+1/2, y+1/2'
18 'z+1/2, -x+1/2, -y+1/2'
19 '-z+1/2, -x+1/2, y+1/2'
20 '-z+1/2, x+1/2, -y+1/2'
21 'y+1/2, z+1/2, x+1/2'
22 '-y+1/2, z+1/2, -x+1/2'
23 'y+1/2, -z+1/2, -x+1/2'
24 '-y+1/2, -z+1/2, x+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
B      B        8     0.304741    0.304741    0.304741 1
Tl     Tl      12     0.881234    0.500000    0.000000 1
#END

