data_from_pyxtal

_symmetry_space_group_name_H-M 'Pban'
_symmetry_Int_Tables_number                   50
_symmetry_cell_setting              orthorhombic
_cell_length_a            7.697026
_cell_length_b            8.531607
_cell_length_c            7.182198
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            471.640592

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y+1/2, z'
3 '-x+1/2, y, -z'
4 'x, -y+1/2, -z'
5 '-x, -y, -z'
6 'x+1/2, y+1/2, -z'
7 'x+1/2, -y, z'
8 '-x, y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Tl     Tl       8     0.866290    0.698750    0.678962 1
P      P        8     0.639237    0.399734    0.060539 1
#END

