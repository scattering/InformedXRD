data_from_pyxtal

_symmetry_space_group_name_H-M 'Pca21'
_symmetry_Int_Tables_number                   29
_symmetry_cell_setting              orthorhombic
_cell_length_a            4.638327
_cell_length_b            7.478123
_cell_length_c            9.000890
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            312.204730

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z+1/2'
3 'x+1/2, -y, z'
4 '-x+1/2, y, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
F      F        4     0.983065    0.966581    0.564933 1
Pa     Pa       4     0.226150    0.577065    0.826227 1
At     At       4     0.764903    0.745612    0.613674 1
#END

