data_from_pyxtal

_symmetry_space_group_name_H-M 'P432'
_symmetry_Int_Tables_number                  207
_symmetry_cell_setting                     cubic
_cell_length_a            9.303098
_cell_length_b            9.303098
_cell_length_c            9.303098
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            805.161019

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-x, y, -z'
4 'x, -y, -z'
5 'z, x, y'
6 'z, -x, -y'
7 '-z, -x, y'
8 '-z, x, -y'
9 'y, z, x'
10 '-y, z, -x'
11 'y, -z, -x'
12 '-y, -z, x'
13 'y, x, -z'
14 '-y, -x, -z'
15 'y, -x, z'
16 '-y, x, z'
17 'x, z, -y'
18 '-x, z, y'
19 '-x, -z, -y'
20 'x, -z, y'
21 'z, y, -x'
22 'z, -y, x'
23 '-z, y, x'
24 '-z, -y, -x'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
I      I       12     0.500000    0.772804    0.772804 1
I      I       24     0.120392    0.824901    0.350431 1
Lu     Lu       3     0.500000    0.000000    0.000000 1
Lu     Lu       1     0.000000    0.000000    0.000000 1
O      O        3     0.000000    0.500000    0.500000 1
#END

