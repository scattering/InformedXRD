data_from_pyxtal

_symmetry_space_group_name_H-M 'P42cm'
_symmetry_Int_Tables_number                  101
_symmetry_cell_setting                tetragonal
_cell_length_a            9.308434
_cell_length_b            9.308434
_cell_length_c            6.402000
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            554.713788

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 '-y, x, z+1/2'
4 'y, -x, z+1/2'
5 'x, -y, z+1/2'
6 '-x, y, z+1/2'
7 '-y, -x, z'
8 'y, x, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
V      V        2     0.000000    0.000000    0.929657 1
V      V        4     0.377329    0.377329    0.235747 1
V      V        2     0.500000    0.500000    0.351585 1
Rb     Rb       4     0.863797    0.863797    0.552271 1
